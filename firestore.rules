rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidWorkspace(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.version is number &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('materials' in data) || data.materials is list) &&
             (!('products' in data) || data.products is list) &&
             (!('purchases' in data) || data.purchases is list) &&
             (!('sales' in data) || data.sales is list) &&
             (!('customers' in data) || data.customers is list) &&
             (!('paymentMethods' in data) || data.paymentMethods is list) &&
             (!('suppliers' in data) || data.suppliers is list) &&
             (!('settings' in data) || data.settings is map) &&
             (!('lastModifiedBy' in data) || (data.lastModifiedBy is string && data.lastModifiedBy.size() <= 100));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      // Atelier Workspace subcollection for multi-device synchronization
      match /workspaces/{workspaceId} {
        allow get: if isOwner(userId) && isValidId(workspaceId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workspaceId) && isValidWorkspace(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(workspaceId) && isValidWorkspace(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(workspaceId);
      }
    }
  }
}
